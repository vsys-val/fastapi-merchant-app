@startuml
title Diagrama de casos de uso — FastAPI Merchant App
left to right direction

actor Visitante
actor "Usuário autenticado" as UsuarioAutenticado

rectangle "API de avaliações de produtos" {
  usecase "UC01\nCadastrar conta" as UC01
  usecase "UC02\nRealizar login" as UC02
  usecase "UC04\nPesquisar produto" as UC04
  usecase "UC05\nConsultar detalhes\nde um produto" as UC05
  usecase "UC06\nCadastrar produto" as UC06
  usecase "UC07\nEditar produto" as UC07
  usecase "UC08\nCadastrar avaliação" as UC08
  usecase "UC09\nEditar avaliação" as UC09
  usecase "UC10\nExcluir avaliação" as UC10
  usecase "UC11\nExcluir produto" as UC11
  usecase "UC12\nConsultar própria conta" as UC12
  usecase "UC13\nConsultar próprias avaliações" as UC13
  usecase "UC14\nConsultar próprios produtos" as UC14
}

Visitante -- UC01
Visitante -- UC02
Visitante -- UC04
Visitante -- UC05

UsuarioAutenticado -- UC04
UsuarioAutenticado -- UC05
UsuarioAutenticado -- UC06
UsuarioAutenticado -- UC07
UsuarioAutenticado -- UC08
UsuarioAutenticado -- UC09
UsuarioAutenticado -- UC10
UsuarioAutenticado -- UC11
UsuarioAutenticado -- UC12
UsuarioAutenticado -- UC13
UsuarioAutenticado -- UC14

note right of UC05
  Sem token: your_review = null
  Com token válido: avaliação pessoal separada
end note

note right of UC07
  Somente o responsável atual, enquanto nenhum
  outro usuário tiver avaliado o produto
end note

@enduml
