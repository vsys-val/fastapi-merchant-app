# Copie para .env na raiz. Valores do ambiente têm prioridade sobre este arquivo.
ENVIRONMENT=development
# Execução local com PostgreSQL próprio:
DATABASE_URL=postgresql+psycopg://merchant:local_password@localhost:5432/merchant
#
# Supabase: copie as URLs em Connect, troque postgresql:// por
# postgresql+psycopg:// e acrescente ?sslmode=require.
# Em rede IPv4, use o Session pooler (porta 5432) em DATABASE_URL.
# Para Alembic, prefira a Direct connection; se a rede não alcançar IPv6,
# use também o Session pooler. Nunca versione a senha real.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Contrato do MVP: 24 horas. Normalmente não é necessário alterar.
ACCESS_TOKEN_EXPIRES_SECONDS=86400
# Origens exatas do frontend, separadas por vírgula. Vazio desativa CORS.
CORS_ALLOWED_ORIGINS=
# Entrega dos códigos de confirmação de conta e recuperação de senha.
# log: grava o e-mail no terminal (somente desenvolvimento; recusado em produção).
# disabled: contas nascem confirmadas e a recuperação de senha fica indisponível.
EMAIL_DELIVERY=log
# E-mails com acesso ao painel administrativo (/admin na interface), separados por vírgula.
ADMIN_EMAILS=
